// =============================================================================
//        NIRI 极简配置 on Cell 键盘布局 with Tab 模式
// =============================================================================

// Installation::
// intall rofi dms-shell lxqt-policykit breeze-cursors5 pactl elvish ghostty nvim evince nemo nemo-fileroller
//
// gsettings set org.nemo.desktop show-desktop-icons false
// gsettings set org.gnome.desktop.interface cursor-theme 'breeze-cursors-snow'
// gsettings set org.gnome.desktop.interface cursor-size 36
// gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
// gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
// also, stolen some backgrounds from `/usr/share/backgrounds/`

// Refs::
// - https://github.com/niri-wm/niri/blob/main/resources/default-config.kdl
// - https://github.com/niri-wm/niri/wiki/Configuration:-Key-Bindings

// Screenshots Dir
screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

// =============================================================================
//                             屏幕/显示器配置 (Outputs)
// =============================================================================
output "eDP-1" {
    mode "1920x1200@60"  // 保持原有的分辨率和刷新率
    scale 1.5            // 缩放比例
    position x=0 y=0
}

// 外接屏幕（根据 niri msg outputs 的实际名字修改）
output "HDMI-A-1" { }
// 将第二块屏幕放在左侧:position x=-1920 y=0; 放在上侧:position x=0 y=-1080

// =============================================================================
//                             输入设备配置 (Input)
// =============================================================================
input {
    keyboard {
        xkb { layout "cell"; }
        repeat-delay 500
        repeat-rate 50
    }
}

// =============================================================================
//                             布局与外观 (Layout)
// =============================================================================
prefer-no-csd

layout { // using dms color, to some extend
    center-focused-column "never"
    always-center-single-column
    default-column-display "tabbed"
    gaps 12 // [修改] 从 10 微调至 12，增加现代桌面的呼吸感
    preset-column-widths { proportion 0.5; }

    // [修改] 关闭生硬的 6px 粗聚焦环，改用下方的微光描边
    focus-ring { off; }

    // [新增] 类似 GNOME Libadwaita / KDE Breeze 的细边框
    border {
        on
        width 1.5
        active-color "#ffffff2e"
        inactive-color "#ffffff0d"
        urgent-color   "#f2b8b5"
    }

    // [修改] 柔和的指示器配色与宽度，避免高饱和金色突兀感
    tab-indicator {
        position "right"
        place-within-column
        hide-when-single-tab
        width 6
        gap 3
        gaps-between-tabs 30
        corner-radius 9
        active-color   "#42a5f5"
        inactive-color "#45475a"
        urgent-color   "#f2b8b5"
    }

    // [修改] 增强扩散范围，营造接近原生 DE 的自然悬浮阴影
    shadow {
        on
        softness 36
        spread 6
        offset x=0 y=9
        color "#00000060"
        inactive-color "#00000030"
    }

    insert-hint { color "#42a5f580"; }

    background-color "transparent"
}

// [新增] 概览模式（Mod+Escape）视觉优化，接近 GNOME Activities
overview {
    zoom 0.5
    backdrop-color "#181825"
}

animations {
    workspace-switch { spring damping-ratio=0.93 stiffness=800 epsilon=0.0001; }
    window-open {
        duration-ms 180
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement { spring damping-ratio=0.93 stiffness=750 epsilon=0.0001; }
}

cursor {
    xcursor-theme "breeze-cursors-snow"
    xcursor-size 24
}

// =============================================================================
//                         窗口与图层规则 (Window & Layer Rules)
// =============================================================================
// [修改] 合并重复规则；取消全局半透明以保证当前工作窗口 100% 锐利清晰
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    default-column-width { proportion 0.75; }
}

// [修改] 仅对非聚焦窗口轻微降透，自然突出当前焦点（KDE 焦点跟随质感）
window-rule {
    match is-focused=false
    opacity 0.95
}

// [新增] 所有浮动窗口统一增强深邃投影，区分于平铺层级
window-rule {
    match is-floating=true
    shadow {
        softness 45
        spread 6
        offset x=0 y=12
        color "#00000075"
    }
}

window-rule {
    match app-id="lxqt-policykit-agent"
    open-floating true
    open-focused true
}

// [新增] 将 DMS 壁纸层纳入概览模式的背景中（若壁纸未显示可运行 niri msg layers 核对 namespace）
layer-rule {
    match namespace="^dms.*wallpaper.*"
    place-within-backdrop true
}

// =============================================================================
//                         事件处理 (Event Responders)
// =============================================================================
switch-events {
    lid-close { spawn "dms" "ipc" "call" "lock" "lockAndOutputsOff"; }
}

// =============================================================================
//                             最近窗口切换 (Recent Windows)
// =============================================================================
recent-windows {
    debounce-ms 450
    open-delay-ms 150

    highlight {
        active-color   "#89b4fa66"
        urgent-color   "#f2b8b5cc"
        padding 24
        corner-radius 12
    }

    previews {
        max-height 360
        max-scale 0.5
    }

    binds {
        Mod+Tab           { next-window     scope="all"; }
        Mod+Shift+Tab     { previous-window scope="all"; }
        Mod+grave         { next-window     scope="all" filter="app-id"; }
        Mod+Shift+grave   { previous-window scope="all" filter="app-id"; }
        Alt+Tab           { next-window     scope="workspace"; }
        Alt+Shift+Tab     { previous-window scope="workspace"; }
        Alt+grave         { next-window     scope="workspace" filter="app-id"; }
        Alt+Shift+grave   { previous-window scope="workspace" filter="app-id"; }
    }
}

// =============================================================================
//                             按键绑定 (Key Binds)
// =============================================================================
binds {
    // 左上角 (工作区与桌面总览)
    Mod+Escape { toggle-overview; }
    Mod+Shift+Escape { show-hotkey-overlay; }

    // 键盘快捷键抑制的解除
    Mod+Ctrl+BackSpace repeat=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Ctrl+Shift+BackSpace repeat=false { quit; }

    // Quit 锁屏与休眠
    Mod+Ctrl+Q repeat=false hotkey-overlay-title="lock screen" { spawn "dms" "ipc" "call" "lock" "lockAndOutputsOff"; }
    Mod+Ctrl+Shift+Q repeat=false hotkey-overlay-title="suspend" { spawn-sh "dms ipc call lock lockAndOutputsOff; sleep 1; systemctl suspend"; }

    // Workshop 清除通知 { spawn "dms" "ipc" "call" "notifications" "clearAll"; }
    Mod+W repeat=false hotkey-overlay-title="toggle dms msg" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+W repeat=false hotkey-overlay-title="toggle dms bar" { spawn "dms" "ipc" "call" "bar" "toggle" "index" "0"; }

    // Detach (脱离平铺：切换窗口浮动与焦点)
    Mod+D repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+Shift+D repeat=false { toggle-window-floating; }

    // Auto (自动居中与切换预设列宽)
    Mod+A repeat=false { center-column; }
    Mod+Shift+A repeat=false { switch-preset-column-width; }

    // Stack (堆叠/标签页模式)
    Mod+S repeat=false { toggle-column-tabbed-display; }
    Mod+Shift+S repeat=false { reset-window-height; }

    // East (Expel or Consume) (W-E:右移; W-S-E:左移)
    Mod+E repeat=false { consume-or-expel-window-right; }
    Mod+Shift+E repeat=false { consume-or-expel-window-left; }

    // Zoom 最大化
    Mod+Z repeat=false { maximize-column; }
    Mod+Shift+Z repeat=false { toggle-windowed-fullscreen; }

    // eXec 应用启动器 "dms" "ipc" "call" "spotlight" "toggle"
    Mod+X repeat=false hotkey-overlay-title="rofi launcher" { spawn-sh "rofi -theme fullscreen-preview -show combi -combi-modi window,drun,run -show-icons"; }
    Mod+Shift+X repeat=false hotkey-overlay-title="launch ghostty" { spawn "ghostty"; }

    // Cmd 执行命令
    Mod+C repeat=false hotkey-overlay-title="rofi cmd" { spawn-sh "rofi -theme docu -dmenu -p 'Cmd> ' -font 'Hack 16' | xargs niri msg action"; }
    Mod+Shift+C repeat=false { close-window; }

    // 尺寸微调
    Mod+Minus { set-window-height "-10%"; }
    Mod+Equal { set-window-height "+10%"; }
    Mod+BracketLeft  { set-column-width "-10%"; }
    Mod+BracketRight { set-column-width "+10%"; }

    // 左右切换焦点和移动窗口
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // 在列内各个 Tab 间切换焦点，或调整窗口前后顺序
    Mod+Down { focus-window-down; } // or-workspace-
    Mod+Up   { focus-window-up; }   // or-workspace-
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up   { move-window-up; }

    // 首尾列快速聚焦或移动
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last;  }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last;  }

    // 把当前列移动到 上 / 下 一个工作区
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }

    // 移动到#i工作区
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    // 传送到#i工作区
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // 屏幕管理
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }

    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }

    // 音量与亮度控制
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "+3%"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "-3%"; }
    XF86AudioMute         allow-when-locked=true { spawn "pactl" "set-sink-mute"   "@DEFAULT_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "pactl" "set-source-mute" "@DEFAULT_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "3%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "3%-"; }

    // 截屏
    Print { screenshot; }
}

// =============================================================================
//                               启动项 (Autostart)
// =============================================================================
environment {
    XCURSOR_SIZE "24"
    XCURSOR_THEME "breeze-cursors-snow"
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    SDL_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "gnome"
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "DISPLAY" "LANG" "LC_ALL" "XMODIFIERS" "INPUT_METHOD" "GTK_IM_MODULE" "SDL_IM_MODULE" "QT_IM_MODULE" "LC_CTYPE"
spawn-at-startup "/usr/bin/lxqt-policykit-agent"
spawn-at-startup "dms" "run"
spawn-at-startup "fcitx5" "-d" "--replace"
