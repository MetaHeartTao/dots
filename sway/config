# ==============================================================================
#   SWAY CONFIG; with dms + rofi
# ==============================================================================
# Q:锁屏、W:外壳、D:深层、F:悬浮 4
# A:安排、S:切分、E:编辑、T:标记 4
# Z:最大、X:执行、C:关闭、V:最小 4
# 空格、回车、退格、Esc专用于浏览器、终端、文件、PDF。4
# 上下左右按方向聚焦, PageUp/Dn与1234管工作区、Home/End管屏幕。12

# === Variables ===
set $mod Mod4
set $moS Mod4+Shift
set $moC Mod4+Control
set $dmsc dms ipc call

# 应用程序配置
set $browser_launcher   firefox
set $terminal_launcher  ghostty
set $filer_launcher     nemo
set $viewer_launcher    evince

set $browser_focuser    "(?i)$browser_launcher"
set $terminal_focuser   "(?i)$terminal_launcher"
set $filer_focuser      "(?i)$filer_launcher"
set $viewer_focuser     "(?i)$viewer_launcher"

# === Appearance & General Behavior ===
font pango:hack 20px
show_marks yes
focus_wrapping force

### better multiscreen experance:
workspace_auto_back_and_forth no
focus_follows_mouse no
mouse_warping container

# 窗口标题与边框：锁定为传统的浮动窗口样式
for_window [all] title_window_icon yes
floating_minimum_size 400 x 300
floating_modifier $mod normal
title_align center
default_border normal
default_floating_border normal
# 窗口间隙
gaps inner 2px

# 初始化为 Stacking（堆叠模式）
workspace_layout stacking

# === Autostart Applications ===
# 核心特权与认证代理
exec_always --no-startup-id /usr/bin/lxqt-policykit-agent

# 启动常用应用组
exec --no-startup-id dms run
exec --no-startup-id fcitx5 -d --replace

# 显示器配置 swaymsg -t get_outputs
output eDP-1 resolution 1920x1200@60Hz

# 绑定语法：workspace <wsName> output <显示器A> <备用显示器B>
workspace 1 output DP-3 eDP-1
workspace 2 output DP-3 eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1

# 键盘与输入法环境注入 与 鼠标指针
input type:keyboard {
  xkb_layout "cell"
}
seat * xcursor_theme breeze-cursors-snow 24

# === Keybindings ===
# 多媒体控制（联动高效刷新信号）
bindsym XF86AudioRaiseVolume  exec --no-startup-id "pactl set-sink-volume @DEFAULT_SINK@ +3%"
bindsym XF86AudioLowerVolume  exec --no-startup-id "pactl set-sink-volume @DEFAULT_SINK@ -3%"
bindsym XF86AudioMute         exec --no-startup-id "pactl set-sink-mute   @DEFAULT_SINK@ toggle"
bindsym XF86AudioMicMute      exec --no-startup-id "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
bindsym XF86MonBrightnessUp   exec --no-startup-id "brightnessctl set 3%+"
bindsym XF86MonBrightnessDown exec --no-startup-id "brightnessctl set 3%-"

# 锁屏与休眠 Quit
bindsym $moC+q exec --no-startup-id $dmsc lock lockAndOutputsOff
bindsym $moC+Shift+q exec --no-startup-id $dmsc lock lockAndOutputsOff; sleep 0.1; systemctl suspend

# Workshop bar/msg
bindsym $mod+w exec --no-startup-id $dmsc bar toggle index 0
bindsym $moS+w exec --no-startup-id $dmsc notifications clearAll

# focus Deeper
bindsym $mod+d focus parent
bindsym $moS+d focus child

# 将当前聚焦的窗口在平铺与悬浮之间切换 Float
bindsym $mod+f focus mode_toggle
bindsym $moS+f floating toggle

# change container layout -- Arrange: stack/split, direction
bindsym $mod+a layout toggle stacking splitv
bindsym $moS+a layout toggle split

# 预设下一次切分为水平方向 Split
bindsym $mod+s splith
bindsym $moS+s splitv

# Edit layout (by south-east corner)
bindsym $mod+e mode "edit-refine"
bindsym $moS+e mode "edit-normal"

# mark a window with "TAG" and swap with it
bindsym $mod+t mark --toggle TAG
bindsym $moS+t swap container with mark TAG

# toggle fullscreen for the focused container Zoom
bindsym $mod+z layout toggle stacking tabbed
bindsym $moS+z fullscreen toggle

# 应用启动器 eXec
bindsym $mod+x exec --no-startup-id "rofi -theme fullscreen-preview -show combi -combi-modi window,drun,run -show-icons"
bindsym $moS+x exec --no-startup-id $dmsc spotlight toggle

# 关闭窗口与底层命令透传 Close
bindsym $mod+c exec --no-startup-id "rofi -theme docu -dmenu -p 'Cmd> ' -font 'Hack 16' | xargs swaymsg"
bindsym $moS+c kill

# 暂存区 Void
bindsym $mod+v scratchpad show
bindsym $moS+v move scratchpad

# task switcher
bindsym $mod+Tab focus next sibling
bindsym $moS+Tab exec --no-startup-id "rofi -theme fullscreen-preview -show window -show-icons"

# 应用精准聚焦与条件拉起
bindsym $mod+space     [app_id=$browser_focuser] focus
bindsym $mod+Escape    [app_id=$viewer_focuser] focus
bindsym $mod+Return    [app_id=$terminal_focuser] focus
bindsym $mod+BackSpace [app_id=$filer_focuser] focus

bindsym $moS+space     exec --no-startup-id $browser_launcher
bindsym $moS+Escape    exec --no-startup-id $viewer_launcher
bindsym $moS+Return    exec --no-startup-id $terminal_launcher
bindsym $moS+BackSpace exec --no-startup-id $filer_launcher

# 基础物理焦点切换+几何挪动（经典的上下左右）
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

bindsym $moS+Left  move left
bindsym $moS+Down  move down
bindsym $moS+Up    move up
bindsym $moS+Right move right

# 工作区管理（1-4 极简映射）
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

bindsym $moS+1 move container to workspace number 1
bindsym $moS+2 move container to workspace number 2
bindsym $moS+3 move container to workspace number 3
bindsym $moS+4 move container to workspace number 4

# Gnome like workspacing
bindsym $mod+Page_Up   workspace prev
bindsym $mod+Page_Down workspace next
bindsym $moS+Page_Up   move container to workspace prev
bindsym $moS+Page_Down move container to workspace next

# 屏幕聚焦
bindsym $mod+Home focus output left
bindsym $mod+End  focus output right
bindsym $moS+Home move container to output left
bindsym $moS+End  move container to output right

# === Window Rules ===
no_focus [window_role="pop-up"]
for_window [window_role="About"] floating enable
# for_window [class=".*"] floating enable
# for_window [app_id=".*"] floating enable

### 普通编辑模式
mode "edit-normal" {
    bindsym $mod+Left  move left  250px
    bindsym $mod+Down  move down  200px
    bindsym $mod+Up    move up    200px
    bindsym $mod+Right move right 250px

    bindsym $moS+Left  resize shrink width  250px
    bindsym $moS+Down  resize grow   height 200px
    bindsym $moS+Up    resize shrink height 200px
    bindsym $moS+Right resize grow   width  250px

    bindsym $mod+c move position center
    bindsym $moS+c move position center

    bindsym Space mode "default"
    bindsym BackSpace mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### 精细编辑模式
mode "edit-refine" {
    bindsym $mod+Left  move left  50px
    bindsym $mod+Down  move down  40px
    bindsym $mod+Up    move up    40px
    bindsym $mod+Right move right 50px

    bindsym $moS+Left  resize shrink width  50px
    bindsym $moS+Down  resize grow   height 40px
    bindsym $moS+Up    resize shrink height 40px
    bindsym $moS+Right resize grow   width  50px

    bindsym $mod+c move position center
    bindsym $moS+c move position center

    bindsym Space mode "default"
    bindsym BackSpace mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
